# ============================================
# Root .gitignore – covers Frontend & Backend
# ============================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
Frontend/dist
Frontend/dist-ssr
Backend/dist
Backend/build
build/

# Environment variables (keep your secrets out of the repo)
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pnpm-store/

# Test / coverage reports
coverage/
*.lcov
.nyc_output/

# Cache
.cache/
.vite/
.eslintcache
.turbo

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
*.iml
